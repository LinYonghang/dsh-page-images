{
  "name": "dsh-pdf-pages",
  "version": "0.1.1",
  "description": "Render the PDF attached to a DSH message into one image per page and post the pages back into the conversation",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./render": "./lib/render.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/render.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pdf",
    "attachment",
    "image",
    "pdfium"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinYonghang/dsh-page-images.git",
    "directory": "packages/dsh-pdf-pages"
  },
  "homepage": "https://github.com/LinYonghang/dsh-page-images/tree/main/packages/dsh-pdf-pages",
  "bugs": {
    "url": "https://github.com/LinYonghang/dsh-page-images/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.3.0-0"
    },
    "minVersion": "0.2.0-rc.1",
    "testedVersion": "0.2.2-rc.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
