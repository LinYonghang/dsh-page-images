{
  "name": "dsh-slide-pages",
  "version": "0.1.1",
  "description": "Render the presentation attached to a DSH message into one image per slide and post the slides back into the conversation",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./render": "./lib/render.js",
    "./outline": "./lib/outline.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/render.js",
    "lib/outline.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pptx",
    "powerpoint",
    "slide",
    "attachment",
    "image",
    "libreoffice"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinYonghang/dsh-page-images.git",
    "directory": "packages/dsh-slide-pages"
  },
  "homepage": "https://github.com/LinYonghang/dsh-page-images/tree/main/packages/dsh-slide-pages",
  "bugs": {
    "url": "https://github.com/LinYonghang/dsh-page-images/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  }
}
